# ============================================================
#  HealthBot — Environment Configuration (copy to .env to use)
# ============================================================
# Every value below has a safe default baked into config.py, so the app
# runs out of the box even without a .env file. Copy this file to .env
# only when you want to override something.

# ── App ──────────────────────────────────────────────────────
APP_TITLE=HealthBot — AI Healthcare NLP Assistant

# ── Model Artifacts & Data ───────────────────────────────────
MODEL_PATH=saved_models/disease_classifier.pkl
VECTORIZER_PATH=saved_models/tfidf_vectorizer.pkl
ENCODER_PATH=saved_models/label_encoder.pkl
EMBEDDINGS_PATH=saved_models/tfidf_matrix.pkl
TRAIN_DATA_PATH=data/train.csv
VALIDATE_DATA_PATH=data/validate.csv
TEST_DATA_PATH=data/test.csv
TOP_K_RESULTS=5
TRAIN_SAMPLE_ROWS=200000
SEARCH_INDEX_ROWS=100000
TRAIN_RANDOM_STATE=42
MODEL_METADATA_PATH=saved_models/model_metadata.json
SEARCH_CASES_PATH=saved_models/search_cases.pkl

# Add LightGBM as an extra candidate model when retraining (model/train.py).
# Requires `pip install -r requirements-optional.txt`. Off by default so the
# base install stays light and training never fails for a missing package.
USE_LIGHTGBM_CANDIDATE=False

# ── Flask Server ─────────────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False

# ── Local Ollama Formatter (Optional) ────────────────────────
# Ollama never diagnoses — it only rewrites the structured ML + safety
# output into a friendlier sentence (see utils/ollama_client.py), and even
# then only if verify_grounded_response() does not reject it. Pull any
# instruct model locally first, e.g.: ollama pull qwen2.5:7b
OLLAMA_ENABLED=False
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=60
USE_OLLAMA_RESPONSE_FORMATTER=False

# ── BioBERT Semantic Matcher (Optional, Heavy) ───────────────
# Requires `pip install -r requirements-optional.txt` (torch + transformers).
# Leave disabled unless you need semantic fallback matching beyond the
# dictionary + fuzzy matcher in utils/multilingual_normalizer.py.
BIOBERT_ENABLED=False
BIOBERT_MODEL_NAME=dmis-lab/biobert-base-cased-v1.1
BIOBERT_MIN_SIMILARITY=0.84
BIOBERT_TOP_K_ALIASES=2
BIOBERT_LOCAL_FILES_ONLY=True
BIOBERT_ALIAS_INDEX_PATH=saved_models/biobert_alias_index.npz

# ── Chatbot & Prediction Behavior ────────────────────────────
CONFIDENCE_THRESHOLD=0.30
MAX_CLARIFICATION_TURNS=3
RED_FLAG_FIRST=True
SHOW_DEBUG_OUTPUT=True
EXPLAIN_TOP_K_FEATURES=6
SESSION_TTL_MINUTES=60
