# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
*.pyo
.pytest_cache/

# ── Virtual Environments ─────────────────────────────────────
venv/
.venv/
env/
ENV/
.conda/

# ── Secrets & Config ─────────────────────────────────────────
.env
*.env.local
*.env.production
secrets.json
config_local.py

# ── Model Artefacts (large binaries) ─────────────────────────
saved_models/*.pkl
saved_models/*.bin
saved_models/*.pt
saved_models/*.h5
!saved_models/disease_classifier.pkl
!saved_models/tfidf_vectorizer.pkl
!saved_models/label_encoder.pkl
